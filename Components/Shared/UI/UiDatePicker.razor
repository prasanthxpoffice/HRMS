@inherits UiBase

<div class="mb-3">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="small-label mb-1 d-block">@Label</label>
    }
    <input type="date"
           class="input-ui w-100 @CssClass"
           value="@_formatted"
           min="@(Min.HasValue ? Min.Value.ToString("yyyy-MM-dd") : "")"
           max="@(Max.HasValue ? Max.Value.ToString("yyyy-MM-dd") : "")"
           lang="en-GB"
           disabled="@Disabled"
           @onchange="OnChange" />
</div>

@code {
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public DateTime? Min { get; set; }
    [Parameter] public DateTime? Max { get; set; }
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public string CssClass { get; set; } = "";

    private string _formatted => Value.HasValue ? Value.Value.ToString("yyyy-MM-dd") : "";

    private async Task OnChange(ChangeEventArgs e)
    {
        var result = DateTime.TryParse(e.Value?.ToString(), out var dt) ? dt : (DateTime?)null;
        Value = result;
        await ValueChanged.InvokeAsync(result);
    }
}
