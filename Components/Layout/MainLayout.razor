@inherits LayoutComponentBase
@using HRMS.Services
@using HRMS.Resources
@implements IDisposable
@inject LanguageService Lang
@inject IUserService UserService

<div class="page @(Lang.IsRtl ? "rtl" : "ltr")" dir="@(Lang.IsRtl ? "rtl" : "ltr")">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <UiTopBar />

        <div class="content">
            @if (UserService.HasAuthenticationError)
            {
                <div class="alert alert-danger m-4">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @AppResources.AuthenticationError
                </div>
            }
            else
            {
                <ErrorBoundary>
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent Context="ex">
                        <UiErrorContent Exception="ex" />
                    </ErrorContent>
                </ErrorBoundary>
            }
        </div>
    </main>
</div>

<UiNotification />
<UiErrorModal />
<UiWorkflowModal />


@code {
    protected override async Task OnInitializedAsync()
    {
        await UserService.LoadUserAsync();
        StateHasChanged(); 
        UserService.OnRoleChanged += HandleRoleRefresh;
    }

    public void Dispose()
    {
        UserService.OnRoleChanged -= HandleRoleRefresh;
    }

    private void HandleRoleRefresh(bool _) => InvokeAsync(StateHasChanged);
}
